# Copy to .env.local and fill in. Also add these in your hosting provider's
# environment variables (e.g. Vercel → Project → Settings → Environment Variables).

# --- Sanity CMS -------------------------------------------------------------
# From sanity.io/manage → your project. Leave PROJECT_ID empty to keep using
# the bundled local content (the site works without Sanity).
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-10-01

# Shared secret for the Sanity webhook that refreshes pages on publish
# (app/api/revalidate/route.ts). Any long random string.
SANITY_REVALIDATE_SECRET=

# Only needed locally to run `npm run sanity:seed` (imports existing content).
# sanity.io/manage → API → Tokens → Add token with "Editor" permissions.
# Never commit this or expose it to the browser.
SANITY_API_WRITE_TOKEN=

# --- Analytics --------------------------------------------------------------
NEXT_PUBLIC_GA_ID=

# --- Contact form (app/api/contact/route.ts) ----------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=
CONTACT_TO_EMAIL=
NEXT_PUBLIC_SITE_URL=
SITE_URL=
